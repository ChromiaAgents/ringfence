{
  "name": "Ringfence",
  "version": "1.0.0",
  "description": "Ringfence: a phone line for NEAR. Call in the browser or on WhatsApp, say what to send, confirm with a spoken PIN. A NEAR contract per phone number caps what the AI agent can spend. Money packets split a pot between people who say the agreed words.",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env server.ts --dev",
    "build": "vite build",
    "start": "NODE_ENV=production tsx --env-file-if-exists=.env server.ts",
    "typecheck": "tsc --noEmit",
    "seed": "tsx scripts/seed.ts",
    "test": "DB_FILE=data/test-db.json tsx test/run.ts",
    "demo:check": "vite build --logLevel error && tsx scripts/demo-check.ts",
    "attest": "tsx scripts/attest.ts",
    "test:justhoot": "tsx test/justhoot-cost.ts",
    "test:latency": "MOCK_LLM=1 DB_FILE=data/latency-db.json tsx test/latency.ts",
    "verify:contracts": "tsx scripts/verify-contracts.ts",
    "verify:evidence": "tsx scripts/verify-evidence.ts",
    "live:check": "tsx scripts/live-check.ts",
    "attack": "tsx scripts/attack.ts",
    "import:packet": "tsx --env-file-if-exists=.env scripts/import-packet.ts",
    "dao:wallet": "tsx scripts/dao-wallet.ts",
    "topup:quote": "tsx scripts/topup-quote.ts",
    "asr:eval": "tsx --env-file=.env scripts/asr-eval.ts"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource/archivo-black": "^5.3.0",
    "@near-wallet-selector/core": "^10.1.4",
    "@near-wallet-selector/here-wallet": "^10.1.4",
    "@near-wallet-selector/hot-wallet": "^10.1.4",
    "@near-wallet-selector/intear-wallet": "^10.1.4",
    "@near-wallet-selector/meteor-wallet": "^10.1.4",
    "@near-wallet-selector/modal-ui": "^10.1.4",
    "@near-wallet-selector/my-near-wallet": "^10.1.4",
    "@phala/dcap-qvl": "^0.7.1",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.4",
    "buffer": "^6.0.3",
    "ethers": "^6.17.0",
    "kokoro-js": "^1.2.1",
    "near-api-js": "^7.4.0",
    "opusscript": "^0.1.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.34.5",
    "werift": "^0.26.0",
    "ws": "^8.22.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.2.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
