{
  "name": "callhand",
  "version": "1.0.0",
  "description": "One number, two desks: a voice agent that prepares meme.cooking launches you sign, and a builder desk that quotes from photos. NEAR AI Cloud TEE models, NEAR Intents.",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env server.ts --dev",
    "build": "vite build",
    "start": "NODE_ENV=production tsx --env-file-if-exists=.env server.ts",
    "typecheck": "tsc --noEmit",
    "seed": "tsx scripts/seed.ts",
    "test": "DB_FILE=data/test-db.json tsx test/run.ts",
    "test:justhoot": "tsx test/justhoot-cost.ts",
    "test:meme": "tsx test/meme-cost.ts",
    "test:latency": "MOCK_LLM=1 DB_FILE=data/latency-db.json tsx test/latency.ts"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource/archivo-black": "^5.3.0",
    "@near-wallet-selector/core": "^10.1.4",
    "@near-wallet-selector/here-wallet": "^10.1.4",
    "@near-wallet-selector/hot-wallet": "^10.1.4",
    "@near-wallet-selector/intear-wallet": "^10.1.4",
    "@near-wallet-selector/meteor-wallet": "^10.1.4",
    "@near-wallet-selector/modal-ui": "^10.1.4",
    "@near-wallet-selector/my-near-wallet": "^10.1.4",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.4",
    "ethers": "^6.17.0",
    "kokoro-js": "^1.2.1",
    "opusscript": "^0.1.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.34.5",
    "werift": "^0.26.0",
    "ws": "^8.22.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.2.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
