# NEAR AI Cloud key (cloud.near.ai > API Keys): chat, speech-to-text, photo reading, logo generation
NEARAI_API_KEY=
# Where launches go: testnet (default) or mainnet
NETWORK=testnet
# Public URL of this server, used in launch and deposit links (your ngrok/cloudflared URL when testing WhatsApp)
PUBLIC_URL=http://localhost:8787
# Optional (skipped for the hackathon): Pinata JWT to pin coin descriptions to IPFS. Without it they show on our launch page.
PINATA_JWT=
# Business desk: mainnet NEAR account that receives USDC deposits
OWNER_NEAR_ACCOUNT=
# Business desk: the owner's WhatsApp number (digits, with country code). Messages/calls from it reach the settings desk.
OWNER_WHATSAPP=
# Optional: 1Click JWT from partners.near-intents.org (without it 1Click adds a 0.2% fee)
ONECLICK_JWT=
# Optional: protect /dashboard, /api/state and /api/owner with HTTP basic auth
DASHBOARD_PASSWORD=
# WhatsApp Cloud API (developers.facebook.com > your app > WhatsApp)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Phone wallet (testnet only): the agent account each user's phone-wallet contract lets spend within limits.
# Without both, the wallet desk is a labelled dry run. Create it yourself (HANDOVER.md, Phone wallet); never commit the key.
AGENT_ACCOUNT_ID=
AGENT_PRIVATE_KEY=
# Optional: MPC_SIGNER (default v1.signer-prod.testnet), SEPOLIA_RPC (default publicnode)
# Optional model overrides: LLM_MODEL, STT_MODEL, VISION_MODEL, IMAGE_MODEL; files: OWNER_FILE, LAUNCHPAD_FILE, DB_FILE
# Without a key: MOCK_LLM=1 replaces the model with a keyword script that makes real tool calls, and fakes STT. TTS=off skips the local voice. MOCK_TTFT_MS, MOCK_TOKEN_MS, MOCK_STT_MS tune it.
# FILLER_MS: delay before the "mm, okay" filler (0 = right after transcription, -1 = off)
# Voice: TTS_VOICE (Kokoro voice id, default af_heart), TTS_SPEED (default 1.15)
