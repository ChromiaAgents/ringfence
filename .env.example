# NEAR AI Cloud key (cloud.near.ai > API Keys)
NEARAI_API_KEY=
# Where deposits settle (mainnet NEAR account that receives USDC)
OWNER_NEAR_ACCOUNT=
# Public URL of this server (ngrok/cloudflared URL when testing WhatsApp)
PUBLIC_URL=http://localhost:8787
# Optional: 1Click JWT from partners.near-intents.org (without it 1Click adds a 0.2% fee)
ONECLICK_JWT=
# Optional: protect /dashboard
DASHBOARD_PASSWORD=
# WhatsApp Cloud API (developers.facebook.com > your app > WhatsApp)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
