# NEAR AI Cloud key (cloud.near.ai > API Keys): chat, speech-to-text, logo generation
NEARAI_API_KEY=
# Where launches and the phone wallet go: testnet (default) or mainnet (real money; the wallet contract is UNAUDITED)
NETWORK=testnet
# Public URL of this server, used in launch and wallet links (your ngrok/cloudflared URL when testing WhatsApp)
PUBLIC_URL=http://localhost:8787
# Optional (launch funding from another chain): 1Click JWT from partners.near-intents.org (without it 1Click adds a 0.2% fee)
ONECLICK_JWT=
# Optional: protect /dashboard and /api/state with HTTP basic auth
DASHBOARD_PASSWORD=
# WhatsApp Cloud API (developers.facebook.com > your app > WhatsApp)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Phone wallet: the agent account each user's phone-wallet contract lets spend within limits (on NETWORK).
# Without both, the wallet desk is a labelled dry run. Create it yourself (HANDOVER.md, Phone wallet); never commit the key.
AGENT_ACCOUNT_ID=
AGENT_PRIVATE_KEY=
# Wallet factory (contracts/factory) at ringfence-wallet.near and the custodial owner of WhatsApp-only wallets
# (HANDOVER.md, Deploy to mainnet). Keys stay here only; never commit them.
FACTORY_ACCOUNT_ID=
FACTORY_PRIVATE_KEY=
CUSTODY_ACCOUNT_ID=
CUSTODY_PRIVATE_KEY=
# Required on mainnet or with any key set: HMAC key for phone hashes on chain and PIN pepper (openssl rand -hex 32).
# Also set WHATSAPP_APP_SECRET there: unsigned webhooks are refused on a real server.
WALLET_SECRET=
# The WhatsApp number people text (shown as a wa.me link on /wallet/bind).
WHATSAPP_NUMBER=
# Optional: SMALL_LIMIT=0.2 (NEAR; up to this a spoken PIN confirms, above it the PIN and then the WhatsApp Approve tap), CUSTODIAL_MAX_NEAR=5, CUSTODIAL_DAILY_CAP=20
# Optional: MPC_SIGNER (default v1.signer on mainnet, v1.signer-prod.testnet on testnet), SEPOLIA_RPC (default publicnode)
# EVM chains: built in Ethereum 1, Base 8453, Arbitrum 42161, Optimism 10, Polygon 137, BNB 56, Avalanche 43114 (+ Sepolia).
# RPC_<chainId>=https://... overrides a public RPC; EXTRA_CHAINS='[{"id":..,"name":"..","aliases":[".."],"symbol":"ETH","decimals":18,"rpc":"..","explorer":".."}]' adds chains.
# Bind-page default limits (human units; the user can edit before signing): WALLET_NEAR_PER_TX=0.2 WALLET_NEAR_PER_DAY=0.5
#   WALLET_EVM_PER_TX=0.0005 WALLET_EVM_PER_DAY=0.002 WALLET_DELAY_SEC=600
# Optional model overrides: LLM_MODEL, STT_MODEL, IMAGE_MODEL; files: LAUNCHPAD_FILE, DB_FILE
# Without a key: MOCK_LLM=1 replaces the model with a keyword script that makes real tool calls, and fakes STT. TTS=off skips the local voice. MOCK_TTFT_MS, MOCK_TOKEN_MS, MOCK_STT_MS tune it.
# FILLER_MS: delay before the "mm, okay" filler (0 = right after transcription, -1 = off)
# Text-to-speech: cartesia (cloud, needs CARTESIA_API_KEY; the reply text goes to Cartesia) or kokoro (local, ~90 MB model).
# Default: cartesia when CARTESIA_API_KEY is set, else kokoro.
TTS_PROVIDER=
CARTESIA_API_KEY=
# Optional: CARTESIA_VOICE_ID (default 9626c31c-bec5-4cca-baa8-f8ba9e84c8bc "Jacqueline"), CARTESIA_MODEL (sonic-3.6),
#   CARTESIA_VERSION (2026-08-14), CARTESIA_TIMEOUT_MS (5000), TTS_FALLBACK=kokoro (fall back to local Kokoro on errors)
# TTS_SPEED (default 1.0 cartesia, 1.15 kokoro); TTS_VOICE (Kokoro voice id, default af_heart)
# WhatsApp call audio: fixed UDP range for the firewall (otherwise random ports)
RTC_PORT_MIN=40000
RTC_PORT_MAX=40100

# Money packets (contracts/packets). Empty = packets are labelled dry runs.
PACKETS_ACCOUNT_ID=
# The website's shared demo wallet (browser calls): its PIN is shown on the page; the contract limits what it pays.
DEMO_WALLET_PHONE=
DEMO_PIN=
DEMO_RECIPIENT=
# Seconds a first payment to a new account is held by a phone-only wallet (contract default 600).
WALLET_DELAY_SEC=
